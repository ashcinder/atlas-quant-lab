# Copy this file outside the repository and keep the actual generated file mode 0600.
# Run deploy/chain/init-secrets.sh; do not put database passwords or wallet keys here.
ATLAS_CHAIN_MODE=isolated_lab
ATLAS_CHAIN_SECRETS_DIR=/absolute/private/atlas-chain
ATLAS_NETWORK_SUBNET=172.30.123.0/29
ATLAS_NETWORK_GATEWAY=172.30.123.1
ATLAS_API_IP=172.30.123.2
ATLAS_WEB_IP=172.30.123.3
ATLAS_TLS_PROXY_IP=172.30.123.1
ATLAS_SUPERVISOR_IP=172.30.123.5
ATLAS_SUPERVISOR_IMAGE=atlas-supervisor:20261030-lab-full-v1-amd64
ATLAS_MYSQL_IMAGE=atlas-mysql:8.4-amd64
ATLAS_SUPERVISOR_PAYER_ADDRESS=0xREPLACE_WITH_TEST_ONLY_PAYER
ATLAS_SUPERVISOR_RECIPIENT_ADDRESS=0xREPLACE_WITH_TEST_ONLY_RECIPIENT
ATLAS_SUPERVISOR_FEE_ADDRESS=0xREPLACE_WITH_TEST_ONLY_FEE_SINK
QUANTJUDGE_SUPERVISOR_RPC_URL=http://supervisor:42515
TRINE_PROOF_RECIPIENT=0xREPLACE_WITH_TEST_ONLY_RECIPIENT
TRINE_PROOF_PRICE_BKC=1
