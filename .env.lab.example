# Copy to a private file outside source control and replace every example value.
COMPOSE_PROJECT_NAME=atlas-quant-lab
ATLAS_DOMAIN=atlas.example.com
ATLAS_ALLOWED_ORIGINS=https://atlas.example.com
ATLAS_HTTP_PORT=18086
ATLAS_HTTPS_PORT=443
ATLAS_TLS_CERT_FILE=/etc/letsencrypt/live/atlas.example.com/fullchain.pem
ATLAS_TLS_KEY_FILE=/etc/letsencrypt/live/atlas.example.com/privkey.pem

ATLAS_ALLOW_REGISTRATION=false
ATLAS_COOKIE_SECURE=true
# Empty means the API generates a persistent 0600 secret inside atlas-data.
ATLAS_SESSION_SECRET=
VITE_TRINE_DEMO_MODE=false
VITE_TRINE_TEST_PRIVATE_KEY=
TRINE_PROOF_PRICE_BKC=
TRINE_PROOF_RECIPIENT=
QUANTJUDGE_SUPERVISOR_RPC_URL=http://127.0.0.1:42515

ATLAS_API_IMAGE=atlas-quant-api:20261030-lab-v1-amd64
ATLAS_WEB_IMAGE=atlas-quant-web:20261030-lab-v1-amd64
ATLAS_NETWORK_SUBNET=172.30.120.0/29
ATLAS_NETWORK_GATEWAY=172.30.120.1
ATLAS_API_IP=172.30.120.2
ATLAS_WEB_IP=172.30.120.3
ATLAS_TLS_PROXY_IP=172.30.120.1
ATLAS_TRUSTED_PROXY_IPS=172.30.120.3
