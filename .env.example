# Independent server public URL (no trailing slash). Local development needs no .env.
ATLAS_ALLOWED_ORIGINS=https://atlas.example.com
ATLAS_ALLOW_REGISTRATION=true
# Optional: set at least 32 random characters. Otherwise /data/.session-secret
# is generated once and persisted with the database volume.
ATLAS_SESSION_SECRET=

# Optional: copy to .env in the repository root before docker compose up.
# The public bind address is intentionally NOT configurable: local-only by default.
ATLAS_HTTP_PORT=8080
ATLAS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
ATLAS_ALLOW_REGISTRATION=true
# Leave empty to generate a persistent 0600 secret in backend/.data.
ATLAS_SESSION_SECRET=

# Keep this unreachable default unless you explicitly want read-only RPC access.
# Containers do not share the host's 127.0.0.1. Connecting your existing node needs
# a separately reviewed network route; never publish or mount Supervisor here.
QUANTJUDGE_SUPERVISOR_RPC_URL=http://127.0.0.1:42515

# Optional local Ollama provider for AI risk review and the multilingual strategy assistant.
# Only a numeric loopback HTTP address is accepted; strategy-assistant requests send
# the current editor source to this provider.
# ATLAS_AI_MODEL=your-reviewed-local-model
# ATLAS_AI_URL=http://127.0.0.1:11434/api/chat
