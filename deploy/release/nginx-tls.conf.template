# Install inside the host Nginx http context after replacing __...__ values.
limit_req_zone $binary_remote_addr zone=atlas_auth:10m rate=30r/m;

server {
    listen 80;
    server_name __ATLAS_DOMAIN__;
    return 301 https://$host$request_uri;
}

server {
    listen __ATLAS_HTTPS_PORT__ ssl http2;
    server_name __ATLAS_DOMAIN__;
    ssl_certificate __ATLAS_TLS_CERT_FILE__;
    ssl_certificate_key __ATLAS_TLS_KEY_FILE__;

    location ~ ^/api/(login|register)$ {
        limit_req zone=atlas_auth burst=20 nodelay;
        proxy_pass http://127.0.0.1:__ATLAS_HTTP_PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        proxy_pass http://127.0.0.1:__ATLAS_HTTP_PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 300s;
    }
}
